# URL del backend. Dejar vacío en producción (Railway sirve todo desde el mismo dominio).
# En desarrollo local con backend separado: http://localhost:3001
VITE_API_URL=

# Configuración de Firebase (obtener desde console.firebase.google.com)
VITE_FIREBASE_API_KEY=tu-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
