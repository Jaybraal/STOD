rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica si el usuario autenticado es superadmin del sistema
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.uid == 'RESKS8ugyVMK9iIpdjFOyFbA9XF3';
    }

    // Colección users: mapeo uid → clínica
    match /users/{userId} {
      // El propio usuario puede leer/crear su doc
      allow read, create: if request.auth != null && request.auth.uid == userId;

      // El dueño de la clínica puede leer, aprobar y eliminar miembros
      allow read, update, delete: if request.auth != null
        && resource.data.clinicId == request.auth.uid;

      // Superadmin puede leer y eliminar cualquier usuario
      allow read, delete: if isSuperAdmin();
    }

    // Configuración y datos de la clínica
    match /clinics/{clinicId}/{document=**} {
      // Superadmin tiene acceso total
      allow read, write: if isSuperAdmin();

      allow read, write: if request.auth != null && (
        // Es el dueño
        request.auth.uid == clinicId
        ||
        // Es miembro aprobado
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'pending'
        )
      );
    }

    // Superadmins del sistema
    match /superadmins/{userId} {
      // Cada usuario puede leer su propio doc (para detectar si es superadmin)
      allow read: if request.auth != null && request.auth.uid == userId;
      // Solo superadmins pueden escribir (crear otros superadmins)
      allow write: if isSuperAdmin();
    }

    // Códigos de unión — la lectura es pública
    match /codes/{code} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.clinicId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.clinicId == request.auth.uid;
    }
  }
}
